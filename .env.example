# Copy this file to .env and fill in the values.

# --- LLM ------------------------------------------------------------------
# Default: OpenRouter. Set LLM_PROVIDER=anthropic only if you want to use Anthropic directly.
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter

# Model name, as OpenRouter spells it. REQUIRED in practice — llm.py's built-in
# default (anthropic/claude-3.5-sonnet) has been removed from OpenRouter and 404s.
# NB: the variable is CLAUDE_MODEL. OPENROUTER_MODEL is read by nothing.
CLAUDE_MODEL=anthropic/claude-haiku-4.5

# Max LLM calls in flight at once. Each holds a threadpool worker for up to 60 s.
LLM_MAX_CONCURRENCY=4

# --- Access gate (backend/auth.py) ----------------------------------------
# Off by default so local development and the test suite stay open. The
# container sets AUTH_ENABLED=1 itself; set it here too if you run uvicorn
# directly and want the gate.
AUTH_ENABLED=0

# Keys the session cookies AND the stored login-code hashes. Generate once with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it logs everyone out and invalidates every issued login code.
SESSION_SECRET=

# --- Storage --------------------------------------------------------------
# Where app.db, scraper_state.db and uploads live. Defaults to ./data.
# The container overrides this to /data (a mounted volume).
# APP_DATA_DIR=

# --- Docker (compose.yaml) -------------------------------------------------
# ./data is bind-mounted, so the container must run as the UID/GID that owns
# it on your host, or it cannot write app.db/scraper_state.db. Fill in your
# own: `id -u` and `id -g`.
HOST_UID=
HOST_GID=

# --- Tailscale sidecar (compose.yaml) -------------------------------------
# Reusable auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
# Becomes the hostname within your tailnet: https://<TS_HOSTNAME>.<tailnet>.ts.net
# Private tailnet only — no Funnel — so this URL only resolves and connects for
# devices actually authorized into your tailnet. See README "Jagatud testimine"
# for how to share just this one node with a tester without giving them your
# whole network.
TS_HOSTNAME=rahastusmeetmed
# --reset makes containerboot always apply exactly this flag set, discarding
# whatever `tailscale up` flags a previous container run left in the state
# volume (e.g. an old --advertise-tags from an earlier Funnel setup) instead of
# refusing to start until they're reconciled by hand.
TS_EXTRA_ARGS=--reset

# --- Source scraper (scraper/) --------------------------------------------
# Weekly check of each measure's EIS page and its Riigi Teataja act. Off by
# default so tests and local development never touch the network. Turn on in
# the deployed environment only.
SCRAPER_ENABLED=0
SCRAPER_INTERVAL_DAYS=7

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
